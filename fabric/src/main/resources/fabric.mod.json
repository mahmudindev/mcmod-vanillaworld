  "name": "Vanilla World",
  "description": "Add vanilla dimensions while keeping the original dimensions.",
  "authors": [
    "mahmudindev"
  ],
  "contact": {
    "homepage": "https://github.com/mahmudindev",
    "sources": "https://github.com/mahmudindev/mcmod-vanillaworld"
  },
  "license": "ARR",
  "icon": "assets/vanillaworld/icon.png",
